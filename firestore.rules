rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }

    function isValidProduct(data) {
      let hasRequired = data.keys().hasAll(['name', 'category', 'unit', 'price', 'updatedAt']);
      let validTypes = data.name is string && data.name.size() > 0 && data.name.size() <= 200
          && data.category is string && data.category.size() > 0 && data.category.size() <= 100
          && data.unit is string && data.unit.size() > 0 && data.unit.size() <= 50
          && data.price is number && data.price >= 0
          && data.updatedAt is number;
      let validDesc = !('description' in data) || (data.description is string && data.description.size() <= 1000);
      let validSize = data.keys().size() == 5 || (data.keys().size() == 6 && 'description' in data);
      return hasRequired && validTypes && validDesc && validSize;
    }

    function isValidSale(data) {
      let hasRequired = data.keys().hasAll(['productId', 'productName', 'quantity', 'totalPrice', 'paymentMethod', 'timestamp']);
      let validTypes = data.productId is string && data.productId.size() > 0 && data.productId.size() <= 128
          && data.productName is string && data.productName.size() > 0 && data.productName.size() <= 200
          && data.quantity is number && data.quantity > 0
          && data.totalPrice is number && data.totalPrice >= 0
          && data.paymentMethod in ['Cash', 'UPI']
          && data.timestamp is number;
      return hasRequired && validTypes && data.keys().size() == 6;
    }

    function isValidExpense(data) {
      let hasRequired = data.keys().hasAll(['name', 'amount', 'timestamp']);
      let validTypes = data.name is string && data.name.size() > 0 && data.name.size() <= 200
          && data.amount is number && data.amount >= 0
          && data.timestamp is number;
      return hasRequired && validTypes && data.keys().size() == 3;
    }

    match /products/{productId} {
      // The user explicitly requested an app with NO AUTH, so any user can read and manage the catalog.
      
      allow read: if true;
      
      allow create: if isValidId(productId) 
                    && isValidProduct(incoming());
                    
      allow update: if isValidId(productId) 
                    && isValidProduct(incoming()) 
                    && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'unit', 'price', 'description', 'updatedAt']);
                    
      allow delete: if isValidId(productId);
    }
    
    match /sales/{saleId} {
      allow read: if true;
      allow create: if isValidId(saleId) && isValidSale(incoming());
      allow update: if isValidId(saleId) && isValidSale(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['productId', 'productName', 'quantity', 'totalPrice', 'paymentMethod', 'timestamp']);
      allow delete: if isValidId(saleId);
    }
    
    match /expenses/{expenseId} {
      allow read: if true;
      allow create: if isValidId(expenseId) && isValidExpense(incoming());
      allow update: if isValidId(expenseId) && isValidExpense(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'amount', 'timestamp']);
      allow delete: if isValidId(expenseId);
    }
  }
}
